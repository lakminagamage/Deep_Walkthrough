# LLM
OPENAI_API_KEY=sk-...

# Web search
TAVILY_API_KEY=tvly-...

# App
DEBUG_MODE=true
LOG_LEVEL=debug
DEFAULT_MODEL=gpt-4o

# LLM Cache
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=3600

# Retrieval
MAX_RETRIEVAL_STEPS=8
MAX_TOOL_RETRIES=3
RETRIEVAL_TOP_K=10

# Critic
MAX_REVISIONS=2
CRITIC_PASS_THRESHOLD=0.75
